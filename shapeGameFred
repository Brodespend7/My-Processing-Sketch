class Target {
  // Member Variables
  int x, y, size;
  color c1;
  PImage p1;

  // Constructor
  Target() {
    x = int(random(width));
    y = int(random(height)); // Fixed: changed x to y
    size = int(random(20, 100));
    c1 = color(random(255), random(255), random(255));
    p1 = loadImage("");
    // p1 = loadImage("target.png"); // Fixed: pass a valid filename or remove if unused
  }

  // Member Methods
  void display() {
    fill(c1);
    ellipse(x, y, size, size);
  }

  void relocate() {
    x = int(random(width));
    y = int(random(height));
  }
}
